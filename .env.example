# Másold le ezt .env névvel és töltsd ki!
# A .env soha ne kerüljön git-be!

# Django
SECRET_KEY=ide-egy-eros-veletlen-string-kell
DEBUG=False
ALLOWED_HOSTS=a-droplet-ip-cimedpl-167.99.1.2
# Ha van domain: ALLOWED_HOSTS=sajatdomain.com

# CORS - a frontend URL-je (a droplet IP-je vagy domain)
CORS_ALLOWED_ORIGINS=http://a-droplet-ip-cimedpl-167.99.1.2
# Ha van domain: CORS_ALLOWED_ORIGINS=http://sajatdomain.com

# Redis (docker-compose service neve: redis)
REDIS_URL=redis://redis:6379

# SQLite útvonal (a volume-ban)
DB_PATH=/app/db/db.sqlite3

# Frontend build idején beégetett API URL (docker-compose build arg)
# Ezt a docker-compose.yml-ben kell majd megadni build args-ként
# VITE_API_URL=http://a-droplet-ip-cimedpl-167.99.1.2
# VITE_WS_URL=ws://a-droplet-ip-cimedpl-167.99.1.2

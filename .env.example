# Copy this as .env and fill it out!
# .env should never be committed to git!

# Django
SECRET_KEY=strong-random-string
DEBUG=False
ALLOWED_HOSTS=droplet-ip-167.99.1.2
# If you have a domain: ALLOWED_HOSTS=sajatdomain.com

# CORS - frontend URL (droplet IP or domain)
CORS_ALLOWED_ORIGINS=http://droplet-ip-167.99.1.2
# If you have a domain: CORS_ALLOWED_ORIGINS=http://sajatdomain.com

# Redis (docker-compose service name: redis)
REDIS_URL=redis://redis:6379

# SQLite path (inside the volume)
DB_PATH=/app/db/db.sqlite3

# API URL embedded at frontend build time (docker-compose build arg)
# This must be set in docker-compose.yml as build args
# VITE_API_URL=http://droplet-ip-167.99.1.2
# VITE_WS_URL=ws://droplet-ip-167.99.1.2